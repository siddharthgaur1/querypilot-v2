# All optional. Without ANTHROPIC_API_KEY/Ollama, /query serves pre-verified
# example questions from data/examples.json, executed live through the same
# safety+RAG+execution path (not a canned response) — see README.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OLLAMA_MODEL=llama3.2

# Force demo mode even if a key/daemon is present (used by hosted demos).
QUERYPILOT_DEMO=

MAX_ROWS=1000
QUERY_TIMEOUT_S=15
QUERYPILOT_ALLOWED_TABLES=

DATA_DIR=./data
DEFAULT_DB_PATH=./data/fintech.db

CHROMA_HOST=localhost
CHROMA_PORT=8001
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCHEMA_TOP_K=3
HISTORY_TOP_K=3

POSTGRES_DSN=postgresql://querypilot:querypilot@localhost:5433/querypilot
